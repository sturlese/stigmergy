{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "synapse",
    "description": "The company brain — ask it questions, react 🧠 to keep something",
    "background_color": "#2C2D30"
  },
  "features": {
    "bot_user": {
      "display_name": "brain",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "reactions:read",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true
  }
}
