# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p8

# Agent/editor local state — may hold API tokens for a running deployment. `skills/` is the
# one exception: those describe how to work on THIS repo, so they belong to it. Nothing
# deployment-specific may be written into them — coordinates live in the gitignored .env.
.claude/*
!.claude/skills/

# Local test stack / data volumes
.data/
*.sqlite
*.duckdb

# macOS / editors
.DS_Store
.idea/
.vscode/

# Build/demo/eval outputs
out/
evals/out/

# `deploy/` holds the three files the image bakes in. The versions committed here are EMPTY,
# SAFE DEFAULTS so a fresh clone can `docker build`. scripts/deploy_staging.sh overwrites them
# with the knowledge repo's real ops/ files immediately before a deploy — those must never be
# committed, and tests/test_deploy_defaults.py fails loudly if they are.

# coverage artifacts
.coverage
