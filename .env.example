# Local knowledge checkout
STIGMERGY_REPO=../stigmergy-brain

# Postgres and embeddings
STIGMERGY_INDEX_DSN=postgresql://stigmergy:stigmergy@localhost:54321/stigmergy
STIGMERGY_TEST_DSN=postgresql://stigmergy:stigmergy@localhost:54321/stigmergy_test
OPENAI_API_KEY=
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-large
# EMBED_DIMENSIONS=3072
# EMBED_BATCH=64

# Answer and filing models
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# ANSWER_LLM=openai
# ANSWER_MODEL=gpt-5.6-terra
# ANSWER_REASONING_EFFORT=medium
STIGMERGY_LIBRARIAN_BACKEND=pydantic
STIGMERGY_LIBRARIAN_MODEL=anthropic:claude-sonnet-5
# STIGMERGY_LIBRARIAN_MAX_TURNS=12
# STIGMERGY_LIBRARIAN_TIMEOUT_S=300
# STIGMERGY_LIBRARIAN_GARDEN_AT=05:07
# STIGMERGY_OCR_LANGUAGES=eng

# Private evidence store; local defaults match docker-compose
STIGMERGY_EVIDENCE_ENDPOINT=http://localhost:9000
STIGMERGY_EVIDENCE_BUCKET=stigmergy-evidence
STIGMERGY_EVIDENCE_ACCESS_KEY_ID=minioadmin
STIGMERGY_EVIDENCE_SECRET_ACCESS_KEY=minioadmin

# Writer GitHub App
STIGMERGY_LIBRARIAN_APP_ID=
STIGMERGY_LIBRARIAN_INSTALLATION_ID=
STIGMERGY_LIBRARIAN_PRIVATE_KEY_FILE=
# STIGMERGY_LIBRARIAN_PRIVATE_KEY=
STIGMERGY_LIBRARIAN_REPO_URL=
