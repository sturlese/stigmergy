# Local knowledge checkout (the writer's per-workspace checkout root when deployed)
STIGMERGY_REPO=../knowledge
# The workspace a local CLI acts for (slug); optional while only one workspace is active
# STIGMERGY_TENANT=demo

# Postgres and approved OpenRouter models
STIGMERGY_INDEX_DSN=postgresql://stigmergy_app:stigmergy_app@localhost:54321/stigmergy
STIGMERGY_TEST_DSN=postgresql://stigmergy_app:stigmergy_app@localhost:54321/stigmergy_test
OPENROUTER_API_KEY=
ANSWER_LLM=openrouter
ANSWER_MODEL=openrouter:deepseek/deepseek-v4.1-flash
STIGMERGY_LIBRARIAN_BACKEND=pydantic
STIGMERGY_LIBRARIAN_MODEL=openrouter:deepseek/deepseek-v4.1-flash
STIGMERGY_OCR_MODEL=openrouter:qwen/qwen3-vl-8b-instruct
STIGMERGY_LIBRARIAN_MAX_TURNS=3
# STIGMERGY_LIBRARIAN_TIMEOUT_S=300
# The writer's daily garden and index rebuild of each workspace, in UTC (HH:MM, or off)
# STIGMERGY_LIBRARIAN_GARDEN_AT=05:07
# STIGMERGY_INDEX_REBUILD_AT=04:17
# Seconds idle before the writer stops its machine (0 keeps it running); the app wakes it with
# a Fly deploy token limited to the app
# STIGMERGY_LIBRARIAN_IDLE_EXIT_S=600
# STIGMERGY_FLY_API_TOKEN=

# Private evidence store; local defaults match docker-compose
STIGMERGY_EVIDENCE_ENDPOINT=http://localhost:9000
STIGMERGY_EVIDENCE_BUCKET=stigmergy-evidence
STIGMERGY_EVIDENCE_ACCESS_KEY_ID=minioadmin
STIGMERGY_EVIDENCE_SECRET_ACCESS_KEY=minioadmin

# Writer GitHub App
STIGMERGY_LIBRARIAN_APP_ID=
STIGMERGY_LIBRARIAN_INSTALLATION_ID=
STIGMERGY_LIBRARIAN_PRIVATE_KEY_FILE=
# STIGMERGY_LIBRARIAN_PRIVATE_KEY=
# The GitHub organization that holds every workspace's knowledge repository
# STIGMERGY_GITHUB_ORG=your-org
# STIGMERGY_LIBRARIAN_APP_LOGIN=stigmergy-librarian
# STIGMERGY_LIBRARIAN_BRANCH=main
# STIGMERGY_LIBRARIAN_REQUIRE_REMOTE_BASE=true
# STIGMERGY_LIBRARIAN_WORKTREE_ROOT=

# HTTP MCP service (people and tokens live in Postgres; see `stigmergy-admin operator bootstrap`)
# STIGMERGY_PUBLIC_HOST=brain.example.com
# Serve the operator's own landing page (web/landing.html, built into the image) at the bare host;
# otherwise the bare host redirects to the backoffice sign-in
# STIGMERGY_LANDING=on
# The operator's legal pages, one Markdown file each, served by the app
# STIGMERGY_LEGAL_DIR=

# Local stdio MCP server: the identity it serves as (HTTP resolves identity per request)
# STIGMERGY_IDENTITY=member@example.com

# Official local MCP bridge
STIGMERGY_URL=https://brain.example.com
STIGMERGY_TOKEN=
# STIGMERGY_GOOGLE_CLIENT_SECRETS=/absolute/path/google-oauth-client.json

# Slack Socket Mode
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Incremental GitHub index webhook
# STIGMERGY_GITHUB_WEBHOOK_SECRET=
# STIGMERGY_GITHUB_WEBHOOK_FILE_CAP=50

# Deployment helpers
# FLY_APP=your-staging-app
# STAGING_DSN=
# STAGING_DATABASE=
# `make deploy-staging`: 1 starts the Slack adapter; the legal pages to copy onto every machine
# STIGMERGY_SLACK_MACHINES=0
# STIGMERGY_LEGAL_SOURCE=
